import sys
sys.stdin = open("01_input.txt","r",encoding="utf-8")

def solutions():

    T = int(input())
    print(T)
    for tc in range(1,T+1):
        N = int(input())
        prices = list(map(int,input().split(" ")))

        prices.reverse()

        max_price = 0
        profit = 0

        for price in prices:
            if price > max_price:
                max_price = price
            else:
                profit += max_price - price


        print(f"{tc} {profit}")
    

solutions()